  "volatility_adjustment_rules": {
    "market_conditions": {
      "bull_market": {
        "multiplier": 0.8,
        "description": "Reduce thresholds in bull markets"
      },
      "bear_market": {
        "multiplier": 1.2,
        "description": "Increase thresholds in bear markets"
      },
      "sideways_market": {
        "multiplier": 1.0,
        "description": "Keep normal thresholds"
      }
    },
    "time_based": {
      "asian_session": {
        "multiplier": 1.1,
        "description": "Lower liquidity in Asian session"
      },
      "us_session": {
        "multiplier": 0.9, 
        "description": "Higher liquidity in US session"
      },
      "european_session": {
        "multiplier": 0.95,
        "description": "Good liquidity in European session"
