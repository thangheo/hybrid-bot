# Build stage
FROM debian:bullseye-slim as builder
# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libzmq3-dev \
    libboost-all-dev \
    pkg-config \
    && git clone https://github.com/zeromq/cppzmq.git /tmp/cppzmq \
    && cd /tmp/cppzmq \
    && mkdir build && cd build \
    && cmake .. \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/cppzmq \
    && rm -rf /var/lib/apt/lists/*
# Set working directory
WORKDIR /app
# Copy source files
COPY . .
# Clean build directory and rebuild
RUN mkdir -p build && \
    cd build && \
    cmake -DCMAKE_INSTALL_PREFIX=/app/install .. && \
    make -j$(nproc) && \
    make install

# Runtime stage
FROM debian:bullseye-slim
# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libzmq3-dev \
    libboost-system1.74.0 \
    && rm -rf /var/lib/apt/lists/*
# Set working directory
WORKDIR /app
# Copy built binaries and config from builder stage
COPY --from=builder /app/install/bin/ /app/bin/
COPY --from=builder /app/config/ /app/config/
# Set entrypoint to run the data ingestion service
ENTRYPOINT ["/app/bin/data_ingestion"]