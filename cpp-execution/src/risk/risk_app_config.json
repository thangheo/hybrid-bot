{
    "position_limits": {
        "asset_limits": {
            "BTC": 2.0,
            "ETH": 20.0,
            "BNB": 100.0,
            "ADA": 10000.0,
            "USDT": 100000.0
        },
        "strategy_limits": {
            "imbalance_strategy": 50000.0,
            "momentum_strategy": 30000.0,
            "arbitrage_strategy": 75000.0
        },
        "exchange_limits": {
            "BINANCE": 80000.0,
            "COINBASE": 60000.0,
            "KRAKEN": 40000.0
        },
        "default_limit": 5000.0,
        "enforce_strictly": true
    },
    "exposure_limits": {
        "max_total_exposure": 200000.0,
        "max_asset_exposure": 75000.0,
        "max_strategy_exposure": 100000.0,
        "max_exchange_exposure": 150000.0,
        "volatility_multiplier": 1.5,
        "include_unrealized_pnl": true
    },
    "circuit_breaker": {
        "metric_thresholds": {
            "error_rate": {
                "warning_threshold": 0.05,
                "critical_threshold": 0.10,
                "is_higher_better": false
            },
            "latency_ms": {
                "warning_threshold": 100.0,
                "critical_threshold": 500.0,
                "is_higher_better": false
            },
            "success_rate": {
                "warning_threshold": 0.95,
                "critical_threshold": 0.90,
                "is_higher_better": true
            },
            "drawdown_percent": {
                "warning_threshold": 5.0,
                "critical_threshold": 10.0,
                "is_higher_better": false
            }
        },
        "cooling_period_seconds": 300,
        "warmup_period_seconds": 60,
        "auto_resume": true,
        "max_triggers_per_day": 10,
        "gradual_trading_resumption": true
    },
    "stop_loss": {
        "max_loss_percentage": 0.05,
        "trailing_stop_distance": 0.02,
        "enable_trailing_stop": true,
        "enable_default_stop_loss": true,
        "force_liquidation": true,
        "liquidation_delay_seconds": 5
    },
    "drawdown": {
        "warning_threshold": 0.10,
        "critical_threshold": 0.20,
        "lookback_period_hours": 24,
        "enable_auto_risk_reduction": true,
        "risk_reduction_factor": 0.5
    },
    "fat_finger": {
        "max_price_deviation": 0.05,
        "max_order_size": 10.0,
        "typical_order_size": 1.0,
        "notional_value_limit": 50000.0,
        "enforce_additional_verification": true
    },
    "order_validation": {
        "validate_min_order_size": true,
        "validate_price_range": true,
        "enforce_symbol_whitelist": false,
        "max_price_deviation_percent": 10.0,
        "default_min_order_size": 0.001,
        "max_order_size": 1000000.0,
        "allowed_order_types": ["MARKET", "LIMIT", "STOP", "STOP_LIMIT"],
        "allowed_time_in_force": ["GTC", "IOC", "FOK"]
    },
    "balance_reconciliation": {
        "reconciliation_frequency_minutes": 30,
        "max_discrepancy_percent": 1.0,
        "auto_correct_discrepancies": false,
        "alert_on_discrepancy": true,
        "max_consecutive_failures": 3,
        "enable_detailed_logging": true
    },
    "rebalancing": {
        "auto_rebalancing_enabled": false,
        "auto_execute_rebalancing": false,
        "rebalancing_interval_minutes": 60,
        "allocation_deviation_threshold": 0.05,
        "minimum_order_size": 0.001,
        "minimum_rebalancing_value": 100.0
    },
    "collateral": {
        "target_free_collateral_ratio": 0.2,
        "enable_emergency_funding": true,
        "funding_sources": ["main_wallet", "backup_wallet"],
        "max_funding_amount": 25000.0,
        "minimum_free_collateral_ratio": 0.15,
        "emergency_funding_threshold": 0.1
    },
    "portfolio": {
        "auto_rebalancing_enabled": false,
        "enable_real_time_metrics": true,
        "enable_allocation_tracking": true,
        "metrics_update_interval_minutes": 5,
        "minimum_portfolio_value": 1000.0,
        "base_currency": "USD",
        "supported_assets": ["BTC", "ETH", "BNB", "ADA", "USDT"],
        "enable_cross_exchange_aggregation": true
    },
    "logging": {
        "log_level": "INFO",
        "log_directory": "/var/log/riskmanagement",
        "enable_detailed_logs": true,
        "log_to_console": true,
        "log_to_file": true,
        "log_retention_period_days": 30
    }
}