{
  "publisher": {
    "market_intel_endpoint": "tcp://*:5555",
    "orderbook_endpoint": "inproc://server_pub",
    "trading_intent_endpoint": "tcp://*:5556",
    "publisher_type": "zeromq",
    "buffer_size": 10000,
    "market_intel_max_queue_size": 100,
    "orderbook_max_queue_size": 100,
    "trading_intent_max_queue_size": 100,
    "intel_max_publish_rate": 50,
    "internal_max_publish_rate": 5000,
    "trading_intent_max_publish_rate": 1000,
    "intel_publish_interval_ms": 15000,
    "internal_publish_interval_ms": 10,
    "trading_intent_publish_interval_ms": 1000,
    "heartbeat_interval_ms": 30000,
    "intel_zmq_linger_ms": 1000,
    "internal_zmq_linger_ms": 1000,
    "trading_intent_zmq_linger_ms": 1000,
    "intel_zmq_hwm": 1000,
    "internal_zmq_hwm": 10000,
    "trading_intent_zmq_hwm": 10000,
    "enable_compression": false,
    "publish_raw_data": true,
    "publish_normalized_data": true,
    "compression": "none",
    "topics": ["MARKET_INTEL", "orderbook", "trades", "ticker", "candles"]
  },
  "exchanges": {
    "binance": {
      "exchange_id": "BINANCE",
      "name": "Binance",
      "ws_url": "wss://stream.binance.com:9443/stream",
      "rest_url": "https://api.binance.com",
      "enable_websocket": true,
      "enable_rest": true,
      "connection_timeout_ms": 30000,
      "reconnect_interval_ms": 5000,
      "max_reconnect_attempts": 10,
      "use_authentication": false,
      "api_key": "",
      "api_secret": "",
      "symbols": [
        {"base": "BTC", "quote": "USDT"},
        {"base": "ETH", "quote": "USDT"},
        {"base": "BNB", "quote": "USDT"},
        {"base": "ADA", "quote": "USDT"},
        {"base": "DOT", "quote": "USDT"}
      ],
      "additional_params": {
        "memory_limit_kb": "204800"
      }
    },
    "coinbase": {
      "exchange_id": "COINBASE",
      "name": "Coinbase Pro",
      "ws_url": "wss://ws-feed.pro.coinbase.com",
      "rest_url": "https://api.pro.coinbase.com",
      "enable_websocket": true,
      "enable_rest": true,
      "connection_timeout_ms": 30000,
      "reconnect_interval_ms": 5000,
      "max_reconnect_attempts": 10,
      "use_authentication": false,
      "api_key": "",
      "api_secret": "",
      "symbols": [
        {"base": "BTC", "quote": "USD"},
        {"base": "ETH", "quote": "USD"}
      ]
    }
  },
  "normalization": {
    "enable_normalization": true,
    "timestamp_format": "iso8601",
    "price_format": "decimal",
    "volume_format": "decimal",
    "validate_checksum": true,
    "max_depth": 20
  },
  "order_book": {
    "depth": 10,
    "track_orders": false,
    "snapshot_interval_ms": 60000,
    "cleanup_interval_ms": 300000
  },
  "data_quality": {
    "max_price_deviation": 0.1,
    "max_gap_ms": 5000,
    "validation_level": 2,
    "min_volume_threshold": 0.001,
    "max_spread_percentage": 0.05,
    "max_order_age_seconds": 300,
    "min_order_size": 0.001,
    "enable_sequence_validation": true,
    "enable_price_range_filter": true,
    "enable_order_age_filter": true,
    "enable_checksum_filter": true,
    "enable_sequence_gap_filter": true,
    "max_sequence_gap": 100
  },
  "time_sync": {
    "ntp_server": "pool.ntp.org",
    "sync_interval_ms": 300000,
    "max_drift_ms": 1000,
    "max_time_skew_ms": 5000,
    "enable_ntp_sync": true
  },
  "storage": {
    "enable_storage": false,
    "storage_type": "influxdb",
    "connection_string": "http://localhost:8086",
    "database": "crypto_trading",
    "retention_policy": "30d",
    "batch_size": 100,
    "flush_interval_seconds": 10
  },
  "enabled_exchanges": ["BINANCE", "COINBASE"]

}